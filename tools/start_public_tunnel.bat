@echo off
chcp 65001 > nul
echo ====================================================================
echo    🌐 ساخت لینک اینترنتی رایگان جهانی برای داشبورد ترید (بدون کارت بانکی)
echo ====================================================================
echo.

set PORT=8787
if not "%~1"=="" set PORT=%~1

echo در حال ساخت لینک عمومی اینترنتی با Localtunnel روی پورت %PORT%...
echo.
npx -y localtunnel --port %PORT%
pause
